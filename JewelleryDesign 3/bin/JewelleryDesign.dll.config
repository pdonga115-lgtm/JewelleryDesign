<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="dbcon"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=JewelleryDB;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" />
    <authentication mode="Windows" />
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" enableEventValidation="false">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Linq" />
        <add namespace="System.Web" />
        <add namespace="JewelleryDesign" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <appSettings>
    <add key="SiteName" value="Jewellery Design" />
  </appSettings>
</configuration>
